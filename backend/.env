# ==============================================================================
# Configurações de Banco de Dados e Servidor - PlanEat (Back-end)
# ==============================================================================

# Banco H2 em memória com compatibilidade Oracle e execução do script de dados inicial
DB_URL=jdbc:h2:mem:planeat;MODE=Oracle;DB_CLOSE_DELAY=-1;INIT=RUNSCRIPT FROM './database/script.sql'
DB_USER=sa
DB_PASSWORD=

# Cookie de sessão sem flag Secure (necessário para HTTP/localhost em desenvolvimento)
COOKIE_SECURE=false

# Porta do servidor HTTP
PORT=8080

# Origens permitidas para CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173, http://127.0.0.1:5173
